+++++++++++    for (const [key, value] of Object.entries(file)) {
+++++++++++      if (key === "url") continue;
+++++++++++      lines.push(`    ${key}: ${typeof value === "number" ? value : quoteYamlScalar(value)}`);
+++++++++++    }
+++++++++++  }
+++++++++++  if (manifest.releaseDate) lines.push(`releaseDate: ${quoteYamlScalar(manifest.releaseDate)}`);
