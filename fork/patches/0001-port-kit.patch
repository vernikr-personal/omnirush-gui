++++++++  if (existsSync(file)) return readFileSync(file, "utf8").trim();
++++++++  return process.env.GITHUB_REPOSITORY ?? "";
++++++++}
++++++++
++++++++/** The upstream commit the patches in fork/patches were generated against. */
