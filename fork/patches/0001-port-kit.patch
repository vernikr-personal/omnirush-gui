++++++  if (!options.release) {
++++++    throw new Error("Usage: merge-mac-update-manifests.mjs --release <tag> [--repo <owner/repo>] [--inputs <a.yml,b.yml>] [--output <out.yml>] [--dir <dir>] [--keep-inputs] [--dry-run]");
++++++  }
