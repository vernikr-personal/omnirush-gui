+++    const base = String(root ?? "").trim();
+++    if (!base || isNetworkPath(base)) return false;
+++    const relative = pathApi.relative(fold(pathApi.resolve(base)), resolved);
+++    return relative === "" || (!relative.startsWith("..") && !pathApi.isAbsolute(relative));
