+++++++++++    const rightExt = /\.[A-Za-z0-9]+$/.exec(String(right.url || ""))?.[0] ?? "";
+++++++++++    if (leftExt === ".zip" && rightExt !== ".zip") return -1;
+++++++++++    if (rightExt === ".zip" && leftExt !== ".zip") return 1;
