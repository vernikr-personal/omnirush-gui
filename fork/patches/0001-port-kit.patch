+++++++++++      cwd: root,
+++++++++++      stdio: "pipe",
+++++++++++      encoding: "utf8",
+++++++++++    });
+++++++++++    return [];
+++++++++++  } catch (error) {
+++++++++++    const output = `${error?.stdout ?? ""}${error?.stderr ?? ""}`.trim();
