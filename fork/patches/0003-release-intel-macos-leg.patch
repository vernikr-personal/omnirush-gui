+  # electron-updater reads one macOS feed, latest-mac.yml, for every Mac, so
+  # the two macOS legs upload their manifests under their own names and this
+  # job combines them. It runs after both legs (and after notarization rewrote
+  # each DMG's sha512) and before publish verifies the feed.
+  merge-mac-feed:
+    name: Merge macOS update feed
+    needs:
+      - prepare
+      - build
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out release scripts
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ needs.prepare.outputs.tag }}
+          fetch-depth: 1
+          sparse-checkout: scripts/release
+
+      - name: Merge both architectures into latest-mac.yml
+        env:
+          GH_TOKEN: ${{ github.token }}
+          RELEASE_TAG: ${{ needs.prepare.outputs.tag }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          node scripts/release/merge-mac-update-manifests.mjs \
+            --release "$RELEASE_TAG" \
+            --repo "$GITHUB_REPOSITORY" \
+            --inputs latest-mac-arm64.yml,latest-mac-x64.yml \
+            --output latest-mac.yml
+
